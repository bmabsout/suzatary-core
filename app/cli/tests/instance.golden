# read
code = /srv/code
data = /srv/data
chain.life.events = /srv/data/events
chain.life.proposals = /srv/data/events-triage
chain.life.untrusted = ["triage"]
chain.life.roster = ["ada", "assistant", "triage"]
chain.life.owner = ada
chain.suzatary.events = /srv/data/events-suzatary
chain.suzatary.proposals = /srv/data/events-triage-suzatary
chain.suzatary.untrusted = []
chain.suzatary.roster = ["ada", "assistant", "triage"]
chain.suzatary.owner = ada
deployment.chains = ["life", "suzatary"]
deployment.viewers = ["her@example.test", "phone@example.test"]
deployment.act_as.her@example.test = ada
deployment.act_as.phone@example.test = assistant
deployment.categories = {"home": 0, "work": 1}
deployment.app_url = https://box.example.test
instance.settables = ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "DATABRICKS_TOKEN", "FCM_SENDER_ID", "FCM_SERVICE_ACCOUNT_B64", "NTFY_TOPIC", "PHALA_API_KEY", "SUZATARY_DATA_PUSH_TOKEN", "SUZATARY_REPOS_TOKEN", "SUZATARY_ROUTINE_TOKEN"]
deployment.coding = Some(Coding { routine: RoutineId("trig_01fake"), repo: RepoName { owner: "bmabsout", name: "Suzatary" }, chain: ChainName("suzatary") })
serving.host = 100.64.0.1
serving.port = 443
serving.tls_dir = /var/lib/suzatary/tls
serving.dist = /srv/code/web/dist
serving.briefings = /srv/data/briefings
secretary.conversations = /srv/data/secretary
secretary.renders = /srv/data/secretary-render
secretary.inbox = /srv/data/inbox
secretary.memory = /srv/data/memory
secretary.model = claude-opus-5-5
secretary.compacting = Off
secretary.settings = /srv/code/.claude/secretary-settings.json
secretary.web_allow = ["*.gov.uk", "example.org"]
secretary.drive_allow = ["/my-files/Docs"]
secretary.drive_cli = Some("/srv/data/bin/proton-drive")
secretary.repos = Declared({RepoName { owner: "bmabsout", name: "Suzatary" }: RepoTarget { check: None, public: false }, RepoName { owner: "bmabsout", name: "resume_typst" }: RepoTarget { check: Some("typst compile cv.typ"), public: true }})
mail.root = /srv/data/Mail
mail.state = /srv/data/state.json
mail.notmuch = /run/current-system/sw/bin/notmuch
mail.notmuch_config = Some("/srv/data/notmuch-config")
mail.mbsyncrc = /srv/data/mbsyncrc
mail.heartbeat = /srv/data/.local/state/triage-heartbeat
mail.account.her@example.test = MailAccount { email: "her@example.test", subdir: "her-gmail", sync: Gmail }
mail.account.work@example.test = MailAccount { email: "work@example.test", subdir: "work", sync: MsImap(MsImap { authority: Organizations, inbox_folders: ["Inbox", "Other"], sent_folder: "Sent Items" }) }
mail.account.private@example.test = MailAccount { email: "private@example.test", subdir: "proton", sync: Proton(Proton { channel: "proton", smtp_user: "private@example.test", send_addresses: ["private@example.test", "alias@example.test"], inbox_folders: ["INBOX"] }) }
mail.junk = ChurnList { domains: {Domain("offers.example.net"): Ours}, keep: KeepList({Domain("deals.offers.example.net")}), seed: None }
persona = Persona { name: "Ada", city: "London", zone: Zone(Europe/London), prose: Prose { news_filter: [], email_voice: [], anchors: [] } }
local = /srv/data/local
notify = [Fcm, Ntfy]
provider.phala = DeclaredProvider { name: "phala", base_url: "https://inference.phala.com/v1", key: "PHALA_API_KEY", attestation: Required { expect: SourceCommit("8d0a666a2418898a8c823a9af49a634edd122a64") } }
provider.databricks = DeclaredProvider { name: "databricks", base_url: "https://acme.cloud.databricks.com/serving-endpoints", key: "DATABRICKS_TOKEN", attestation: Unclaimed }
models.secretary = ["claude-cli/claude-opus-5-5", "phala/deepseek-v4-flash"]
models.review = ["anthropic/claude-sonnet-5"]
models.title = ["anthropic/claude-haiku-4-5"]
models.reserve = 0.4
fallback = claude-cli/claude-opus-5-5

