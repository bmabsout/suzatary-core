/// The fence plugin's escapees: its worlds plus powers they do not give.
///
/// `escapee` is the source world plus two powers it does not give. Only the
/// names matter to the host, which refuses an import outside the world before it links one, so
/// the WASI interfaces are stubs with one function each.
package suzatary:fence;

world escapee {
    include suzatary:plugin/source@0.3.0;
    import wasi:filesystem/preopens@0.2.0;
    import wasi:sockets/instance-network@0.2.0;
}

/// The fence actor's second world: the actor world plus the network, a power an actor never has.
world actor-escapee {
    include suzatary:plugin/actor@0.3.0;
    import suzatary:plugin/fetch@0.3.0;
}

package wasi:filesystem@0.2.0 {
    interface preopens {
        get-directories: func() -> list<string>;
    }
}

package wasi:sockets@0.2.0 {
    interface instance-network {
        instance-network: func() -> u32;
    }
}
