{
  // The merge gate's tree half, off the box: `scripts/train.sh gate --remote
  // <codespace>` runs `scripts/merge-gate.sh --no-live` here over `gh codespace
  // ssh`. Tools only: Nix with flakes, reading this repository's public Cachix
  // (no token: a substituter is read-only), so `nix develop .#triage` comes
  // from caches where it can. No data tree, no instance file, no secret.
  "name": "Suzatary merge gate",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // `gh codespace ssh` (how the box reaches the gate) needs an SSH server in the container.
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/nix:1": {
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes,extra-substituters = https://bmabsout.cachix.org,extra-trusted-public-keys = bmabsout.cachix.org-1:/GhCEayGQ3NHMIlJiUelQrLtHHXVdGjHtyDz32xNAo4=,max-jobs = auto"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  // The shell's tools, fetched once when the Codespace is made, so a gate
  // starts compiling instead of downloading.
  "postCreateCommand": "nix develop .#triage -c true"
}
