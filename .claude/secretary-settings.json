{
  "claudeMdExcludes": ["**/CLAUDE.md", "**/CLAUDE.local.md"],
  "promptCacheTtl": "1h",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "Monitor"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/secretary-guard.sh\" || exit 2"
          }
        ]
      }
    ]
  }
}
